# ===================================
# FINANCE TRACKER - ENVIRONMENT TEMPLATE
# ===================================
# Copy this file to .env and fill in actual values
# NEVER commit .env to git - it's in .gitignore
# Add secrets to Vercel dashboard instead

# ===================================
# SERVER CONFIGURATION
# ===================================
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-vercel-domain.vercel.app

# ===================================
# DATABASE CONFIGURATION
# ===================================
# For MongoDB Atlas (Cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/finance-tracker?retryWrites=true&w=majority

# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/finance-tracker

# ===================================
# API KEYS & TOKENS
# ===================================
# OpenAI API Key (for AI Advisor)
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxx

# JWT Secret (should be random, 32+ chars)
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters-long

# ===================================
# DEPLOYMENT NOTES
# ===================================
# Local Development:
#   - Run: npm run dev
#   - Frontend: http://localhost:5000
#   - API: http://localhost:5000/api
#
# Vercel Production:
#   - Frontend: https://your-vercel-domain.vercel.app
#   - API: https://your-vercel-domain.vercel.app/api
#   - Add all env vars via Vercel Dashboard > Settings > Environment Variables
